# drive-sort Regeln — deklarativ, erste passende Regel gewinnt.

remote: "gdrive:"

# Ordner die NIE angefasst werden.
protected:
  - Backup
  - secrets

# Ziel-Buckets in Reihenfolge.
buckets:
  - "00_Inbox"
  - "01_Work"
  - "02_Personal"

# Nie hart löschen: Müll → <quarantine>/<datum>/.
quarantine: "99_Review"

# Erste passende Regel gewinnt. Felder: name, target, ext | name_re | empty_gdoc | any
file_rules:
  - name: pdf
    ext: [pdf]
    target: "01_Work"
  - name: rest
    any: true
    target: "00_Inbox"
